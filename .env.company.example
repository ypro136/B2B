# B2B Transportation ERP - Company Portal Environment Configuration
APP_NAME="B2B Transportation ERP - Company Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://company.localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=b2b_transport_erp
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=.localhost

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Portal Configuration
PORTAL_TYPE=company
ADMIN_DOMAIN=admin.localhost
COMPANY_DOMAIN=company.localhost
SANCTUM_STATEFUL_DOMAINS=admin.localhost,company.localhost,localhost

# Multi-tenant
TENANCY_IDENTIFIER=subdomain
TENANCY_CENTRAL_DOMAINS=admin.localhost

# File Storage
FILESYSTEM_DRIVER=local

# API
API_PREFIX=api/v1

# Pagination
DEFAULT_PER_PAGE=15

# Timezone
APP_TIMEZONE=UTC

# Currency
DEFAULT_CURRENCY=USD

# Shipment
DEFAULT_SHIPMENT_STATUS=pending

# Vehicle
DEFAULT_VEHICLE_STATUS=available

# Tracking
TRACKING_UPDATE_INTERVAL=30

# Document
DOCUMENT_MAX_SIZE=10240
DOCUMENT_ALLOWED_TYPES=pdf,doc,docx,jpg,jpeg,png

# Notification
NOTIFICATION_CHANNELS=database,mail

# Queue
QUEUE_FAILED_JOB_RETRY_AFTER=60

# Cache
CACHE_PREFIX=b2b_erp_company

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Sanctum
SANCTUM_TOKEN_EXPIRATION=30

# Two Factor Authentication
TWO_FACTOR_CONFIRMATION_EXPIRATION=120

# Backup
BACKUP_DISK=local
BACKUP_PATH=storage/backups

# Horizon (if using Redis queues)
HORIZON_PREFIX=b2b_erp_company

# Telescope (debugging)
TELESCOPE_ENABLED=false

# Octane (performance)
OCTANE_SERVER=roadrunner

# Reverb (WebSockets)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="0.0.0.0"
REVERB_PORT=8080
REVERB_SCHEME=http

# Vite
VITE_APP_NAME="${APP_NAME}"
VITE_ADMIN_DOMAIN="${ADMIN_DOMAIN}"
VITE_COMPANY_DOMAIN="${COMPANY_DOMAIN}"
VITE_PORTAL_TYPE=company